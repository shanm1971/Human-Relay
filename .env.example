# Backend: never expose database credentials or agent keys as NEXT_PUBLIC variables.
DATABASE_URL=postgresql+psycopg://relay:local-development-only@127.0.0.1:55432/relay
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DEV_AUTH=false
DEV_TOKENS_JSON={}
WEB_ORIGIN=http://localhost:3000
# Configure apps/web/.env.local before building frontend:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
